{
  "name": "tradejs-project",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "ai",
    "claude",
    "codex"
  ],
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "dev": "tradejs-app dev",
    "build": "tradejs-app build",
    "start": "tradejs-app start",
    "backtest": "tradejs backtest",
    "replay": "tradejs replay",
    "results": "tradejs results",
    "ai-export": "tradejs ai-export",
    "ai-pocket-search": "tradejs ai-pocket-search",
    "ai-train": "tradejs ai-train",
    "ml-export": "tradejs ml-export",
    "ml-inspect": "tradejs ml-inspect",
    "ml-train:latest": "tradejs ml-train:latest",
    "research:auto": "tradejs research:auto",
    "research:core": "tradejs research:core",
    "strategy-release": "tradejs strategy-release",
    "runtime-control": "tradejs runtime-control",
    "runtime:manifest": "node ./scripts/write-runtime-package-manifest.mjs",
    "runtime:validate": "node ./scripts/validate-runtime-composition.mjs",
    "clean-tests": "tradejs clean-tests",
    "doctor": "tradejs doctor",
    "infra-up": "tradejs infra-up && yarn ml-infer:up",
    "infra-down": "yarn ml-infer:down && tradejs infra-down",
    "ml-infer:up": "docker compose -f docker-compose.dev.yml up -d --wait --wait-timeout 120 ml-infer",
    "ml-infer:down": "docker compose -f docker-compose.dev.yml stop ml-infer",
    "pgadmin:up": "docker compose -f docker-compose.dev.yml --profile tools up -d --wait --wait-timeout 120 pgadmin",
    "pgadmin:down": "docker compose -f docker-compose.dev.yml --profile tools stop pgadmin",
    "signals:daemon": "tradejs signals-daemon",
    "market:ws": "tradejs market-ws",
    "notes:check": "node ./scripts/research-notes-check.mjs",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "validate": "node ./scripts/validate-project.mjs",
    "test": "node --test ./scripts/*.test.mjs ./.codex/skills/*/scripts/*.test.mjs",
    "checks": "yarn format:check && yarn typecheck && yarn validate && yarn test && yarn notes:check && yarn runtime:manifest && yarn runtime:validate && NODE_ENV=production yarn build"
  },
  "dependencies": {
    "@tradejs/app": "3.1.26-beta.244",
    "@tradejs/base": "3.1.2",
    "@tradejs/cli": "3.1.26-beta.244",
    "@tradejs/connectors": "3.1.26-beta.244",
    "@tradejs/core": "3.1.26-beta.244",
    "@tradejs/indicators": "3.1.26-beta.244",
    "@tradejs/infra": "3.1.26-beta.244",
    "@tradejs/node": "3.1.26-beta.244",
    "@tradejs/strategy-adaptive-momentum-ribbon": "3.0.3",
    "@tradejs/strategy-adaptive-trend-channel": "3.0.4",
    "@tradejs/strategy-breakout": "3.0.3",
    "@tradejs/strategy-cup-and-handle": "3.0.4",
    "@tradejs/strategy-double-tap": "3.0.3",
    "@tradejs/strategy-grid": "3.0.3",
    "@tradejs/strategy-grid-classic": "3.0.3",
    "@tradejs/strategy-head-and-shoulders": "3.0.5",
    "@tradejs/strategy-hyperliquid-consensus": "3.0.3",
    "@tradejs/strategy-kit": "3.0.4",
    "@tradejs/strategy-liquidity-tails": "3.0.4",
    "@tradejs/strategy-liquidity-zones": "3.0.3",
    "@tradejs/strategy-ma-strategy": "3.0.3",
    "@tradejs/strategy-market-flush-reversal": "3.0.5",
    "@tradejs/strategy-relative-rotation": "3.0.3",
    "@tradejs/strategy-structure-zones": "3.0.4",
    "@tradejs/strategy-trend-follow": "3.0.4",
    "@tradejs/strategy-trend-line": "3.0.3",
    "@tradejs/strategy-trend-shift": "3.0.4",
    "@tradejs/strategy-volatility-compression-breakout": "3.0.3",
    "@tradejs/strategy-volume-divergence": "3.0.3",
    "@tradejs/types": "3.1.26-beta.244"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "^7",
    "prettier": "^3.6.2",
    "semver": "^7.8.5",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.x"
  }
}
