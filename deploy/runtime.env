PORT=3000
NODE_ENV=production
APP_URL=https://app.tradejs.dev
RUNTIME_SIGNAL_RETENTION_DAYS=3
SIGNALS_DAEMON_HEAP_MB=2048
SIGNALS_DAEMON_DEPLOYMENT_ID=doubletap-forward
SERVER_HEALTH_HEAP_MB=256
SIGNALS_SUMMARY_HEAP_MB=1024
RUNTIME_EVIDENCE_HEAP_MB=1024
RUNTIME_PARITY_HEAP_MB=3072
DERIVATIVES_INGEST_HEAP_MB=1536
CONTINUITY_HEAP_MB=1536
BACKTEST_PARENT_HEAP_MB=2048
BACKTEST_WORKER_HEAP_MB=1024
BACKTEST_MAX_PARALLEL=1
KLINE_CONCURRENCY_LIMIT=6
SIGNALS_PARALLEL=6
SIGNALS_KLINE_WS_ENABLED=true
SIGNALS_KLINE_WS_WAIT_MS=10000
MARKET_WS_PORT=3001
NEXTAUTH_URL=https://app.tradejs.dev
PUPPETEER_SKIP_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
REDIS_HOST=redis
REDIS_PORT=6379
ML_GRPC_ADDRESS=ml-infer:50051
PG_HOST=timescale
PG_PORT=5432
PG_USER=app
PG_DATABASE=app
DERIVATIVES_CONTEXT_ENABLED=true
DERIVATIVES_CONTEXT_INTERVALS=15m,1h
DERIVATIVES_CONTEXT_LOOKBACK_HOURS=48
DERIVATIVES_CONTEXT_TARGET_ENABLED=false
DERIVATIVES_CONTEXT_EXTRA_REFERENCE_SYMBOLS=BNB,SOL,TRX,XRP
DERIVATIVES_CONTEXT_BACKFILL_BATCH_DAYS=60
DERIVATIVES_CONTEXT_BACKFILL_REQUEST_DELAY_MS=200
DERIVATIVES_CONTEXT_BACKFILL_SYMBOL_BATCH_SIZE=20
