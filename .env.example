AUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_SECRET=replace-with-the-same-random-secret
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=app
PG_PASSWORD=app
PG_DATABASE=app
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_INSIGHT_PORT=5540
ML_GRPC_ADDRESS=127.0.0.1:50051
ML_INFER_IMAGE=ghcr.io/tradejs-dev/tradejs-ml-infer:latest
ML_INFER_PLATFORM=linux/amd64
TRADEJS_PGDATA_VOLUME=investing_pgdata
TRADEJS_REDISDATA_VOLUME=investing_redisdata
TRADEJS_PGADMIN_VOLUME=investing_pgadmin_data

# Set this explicitly for source-aware research to the exact engine or strategy
# repository under study. Research tooling never infers it from PROJECT_CWD.
# TRADEJS_SOURCE_REPOSITORY_ROOT=../investing
# When the source root is a standalone strategy, set the framework checkout
# separately for built @tradejs/node and @tradejs/cli research tooling.
# TRADEJS_FRAMEWORK_REPOSITORY_ROOT=../investing
